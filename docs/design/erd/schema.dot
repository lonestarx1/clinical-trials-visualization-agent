// Entity-relationship diagram for docs/design/16-database.md
// Render: dot -Tpdf docs/design/erd/schema.dot -o docs/design/erd/schema.pdf
digraph schema {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.1, pad=0.4,
         fontname="Helvetica", fontsize=20, labelloc=t,
         label="ClinicalTrials.gov Viz Agent - Database Schema (Postgres)\nPK = primary key, FK = foreign key, UQ = unique (partial), dashed = logical reference (no FK)"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#555555", dir=both, arrowtail=tee, arrowhead=crow];

  data_versions [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#37474F"><FONT COLOR="white"><B>data_versions</B></FONT></TD></TR>
      <TR><TD PORT="data_timestamp" ALIGN="LEFT"><B>data_timestamp</B></TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="data_timestamp_out">PK</TD></TR>
      <TR><TD ALIGN="LEFT">api_version</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">first_seen_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">last_checked_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    </TABLE>>];

  api_searches [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#1565C0"><FONT COLOR="white"><B>api_searches</B> (L1 cache, search level)</FONT></TD></TR>
      <TR><TD PORT="search_key" ALIGN="LEFT"><B>search_key</B></TD><TD ALIGN="LEFT">char(64)</TD><TD PORT="search_key_out">PK</TD></TR>
      <TR><TD ALIGN="LEFT">endpoint</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">params</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text (count|pages|stats|study)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">total_count</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">pages_expected</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">complete</TD><TD ALIGN="LEFT">boolean</TD><TD></TD></TR>
      <TR><TD PORT="verified_data_ts" ALIGN="LEFT">verified_data_ts</TD><TD ALIGN="LEFT">timestamptz</TD><TD>FK</TD></TR>
      <TR><TD ALIGN="LEFT">fetched_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">last_verified_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">last_used_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    </TABLE>>];

  api_pages [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#1565C0"><FONT COLOR="white"><B>api_pages</B> (raw pages)</FONT></TD></TR>
      <TR><TD PORT="search_key" ALIGN="LEFT"><B>search_key</B></TD><TD ALIGN="LEFT">char(64)</TD><TD>PK, FK</TD></TR>
      <TR><TD ALIGN="LEFT"><B>page_index</B></TD><TD ALIGN="LEFT">integer</TD><TD>PK</TD></TR>
      <TR><TD ALIGN="LEFT">n_studies</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">body_gz</TD><TD ALIGN="LEFT">bytea (gzip raw bytes)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">raw_bytes</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">fetched_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    </TABLE>>];

  plan_cache [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#6A1B9A"><FONT COLOR="white"><B>plan_cache</B> (L2, standalone)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>request_key</B></TD><TD ALIGN="LEFT">char(64)</TD><TD>PK</TD></TR>
      <TR><TD ALIGN="LEFT">planner_version</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">plan</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">planner_trace</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">last_used_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">hit_count</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
    </TABLE>>];

  results [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#2E7D32"><FONT COLOR="white"><B>results</B> (L3, immutable rows)</FONT></TD></TR>
      <TR><TD PORT="result_id" ALIGN="LEFT"><B>result_id</B></TD><TD ALIGN="LEFT">uuid</TD><TD PORT="result_id_out">PK</TD></TR>
      <TR><TD ALIGN="LEFT">result_key</TD><TD ALIGN="LEFT">char(64)</TD><TD>idx</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text (ok|no_matching_trials|...)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">request</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">plan</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">response</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD PORT="search_keys" ALIGN="LEFT">search_keys</TD><TD ALIGN="LEFT">char(64)[]</TD><TD>logical</TD></TR>
      <TR><TD PORT="verified_data_ts" ALIGN="LEFT">verified_data_ts</TD><TD ALIGN="LEFT">timestamptz</TD><TD>FK</TD></TR>
      <TR><TD ALIGN="LEFT">schema_version</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">code_version</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>idx</TD></TR>
    </TABLE>>];

  result_datums [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#2E7D32"><FONT COLOR="white"><B>result_datums</B> (one per data point)</FONT></TD></TR>
      <TR><TD PORT="result_id" ALIGN="LEFT"><B>result_id</B></TD><TD ALIGN="LEFT">uuid</TD><TD>PK, FK</TD></TR>
      <TR><TD PORT="datum_key" ALIGN="LEFT"><B>datum_key</B></TD><TD ALIGN="LEFT">text</TD><TD PORT="datum_key_out">PK</TD></TR>
      <TR><TD ALIGN="LEFT">label</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT">double precision</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">citation_count</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">citation_source</TD><TD ALIGN="LEFT">text (trials|api_query)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">source_query</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">citations_materialized</TD><TD ALIGN="LEFT">boolean</TD><TD></TD></TR>
    </TABLE>>];

  result_citations [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#2E7D32"><FONT COLOR="white"><B>result_citations</B> (keyset-paginated)</FONT></TD></TR>
      <TR><TD PORT="result_id" ALIGN="LEFT"><B>result_id</B></TD><TD ALIGN="LEFT">uuid</TD><TD>PK, FK</TD></TR>
      <TR><TD PORT="datum_key" ALIGN="LEFT"><B>datum_key</B></TD><TD ALIGN="LEFT">text</TD><TD>PK, FK</TD></TR>
      <TR><TD ALIGN="LEFT"><B>rank</B></TD><TD ALIGN="LEFT">integer</TD><TD>PK</TD></TR>
      <TR><TD ALIGN="LEFT">nct_id</TD><TD ALIGN="LEFT">char(11)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">evidence</TD><TD ALIGN="LEFT">jsonb [{field, excerpt}]</TD><TD></TD></TR>
    </TABLE>>];

  jobs [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#E65100"><FONT COLOR="white"><B>jobs</B> (background tasks)</FONT></TD></TR>
      <TR><TD PORT="job_id" ALIGN="LEFT"><B>job_id</B></TD><TD ALIGN="LEFT">uuid</TD><TD PORT="job_id_out">PK</TD></TR>
      <TR><TD ALIGN="LEFT">request_key</TD><TD ALIGN="LEFT">char(64)</TD><TD>UQ (active)</TD></TR>
      <TR><TD ALIGN="LEFT">request</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">plan</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text (pending|running|succeeded|failed|cancelled)</TD><TD>idx</TD></TR>
      <TR><TD ALIGN="LEFT">progress</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">estimated_seconds</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD PORT="result_id" ALIGN="LEFT">result_id</TD><TD ALIGN="LEFT">uuid (nullable)</TD><TD>FK</TD></TR>
      <TR><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">attempts / max_attempts</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">locked_by</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">heartbeat_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">trace_id</TD><TD ALIGN="LEFT">uuid</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">created_at / started_at / finished_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    </TABLE>>];

  traces [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#455A64"><FONT COLOR="white"><B>traces</B> (observability)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>trace_id</B></TD><TD ALIGN="LEFT">uuid</TD><TD PORT="trace_id_out">PK</TD></TR>
      <TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text (request|job)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>idx</TD></TR>
      <TR><TD ALIGN="LEFT">request</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">http_status</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">outcome</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">guard</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">stages</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">api_calls</TD><TD ALIGN="LEFT">jsonb</TD><TD></TD></TR>
      <TR><TD PORT="result_id" ALIGN="LEFT">result_id</TD><TD ALIGN="LEFT">uuid (nullable)</TD><TD>FK</TD></TR>
      <TR><TD PORT="job_id" ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid (nullable)</TD><TD>FK</TD></TR>
    </TABLE>>];


  llm_usage [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#AD1457"><FONT COLOR="white"><B>llm_usage</B> (one row per LLM call)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>call_id</B></TD><TD ALIGN="LEFT">uuid</TD><TD>PK</TD></TR>
      <TR><TD PORT="trace_id" ALIGN="LEFT">trace_id</TD><TD ALIGN="LEFT">uuid (nullable)</TD><TD>FK</TD></TR>
      <TR><TD PORT="job_id" ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid (nullable)</TD><TD>FK</TD></TR>
      <TR><TD ALIGN="LEFT">stage</TD><TD ALIGN="LEFT">text (guard|planner|narrator)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT">text</TD><TD>idx</TD></TR>
      <TR><TD ALIGN="LEFT">attempt</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">is_fallback</TD><TD ALIGN="LEFT">boolean</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text (ok|error|timeout)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">input_tokens</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">cached_input_tokens</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">output_tokens</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">reasoning_tokens</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">latency_ms</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">cost_usd</TD><TD ALIGN="LEFT">numeric(12,6)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">price_version</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>idx</TD></TR>
    </TABLE>>];

  registry_trials [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#00695C"><FONT COLOR="white"><B>registry.trials</B> (the mirror, Q22)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>nct_id</B></TD><TD ALIGN="LEFT">text</TD><TD>PK</TD></TR>
      <TR><TD ALIGN="LEFT">record</TD><TD ALIGN="LEFT">jsonb (the API's study)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">start_year</TD><TD ALIGN="LEFT">integer (nullable)</TD><TD>idx</TD></TR>
      <TR><TD ALIGN="LEFT">last_update_post_date</TD><TD ALIGN="LEFT">date (nullable)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">synced_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    </TABLE>>];

  registry_sync_runs [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="3" BGCOLOR="#00695C"><FONT COLOR="white"><B>registry.sync_runs</B> (loads and updates)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>run_id</B></TD><TD ALIGN="LEFT">integer</TD><TD>PK</TD></TR>
      <TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text (load|update)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text (running|succeeded|failed)</TD><TD>idx</TD></TR>
      <TR><TD ALIGN="LEFT">data_timestamp</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">since</TD><TD ALIGN="LEFT">date (nullable)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">upserted, removed</TD><TD ALIGN="LEFT">integer</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT">text (nullable)</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">started_at, finished_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>idx</TD></TR>
    </TABLE>>];

  // Relationships: tail = "one" side (tee), head = "many" side (crow)
  data_versions:data_timestamp_out:e -> api_searches:verified_data_ts:w [xlabel="verified against"];
  data_versions:data_timestamp_out:e -> results:verified_data_ts:w      [xlabel="verified against"];
  api_searches:search_key_out:e -> api_pages:search_key:w          [xlabel="1 search : N pages"];
  results:result_id_out:e -> result_datums:result_id:w       [xlabel="1 result : N data points"];
  result_datums:datum_key_out:e -> result_citations:datum_key:w    [xlabel="1 data point : N citations"];

  // Optional (0..1) links: a job/trace points to at most one result/job
  results:result_id_out:e -> jobs:result_id:w   [arrowtail=teeodot, arrowhead=crowodot,];
  results:result_id_out:e -> traces:result_id:w [arrowtail=teeodot, arrowhead=crowodot];
  jobs:job_id_out:e -> traces:job_id:w    [arrowtail=teeodot, arrowhead=crowodot];

  traces:trace_id_out:e -> llm_usage:trace_id:w [arrowtail=teeodot, arrowhead=crow];
  jobs:job_id_out:e   -> llm_usage:job_id:w   [arrowtail=teeodot, arrowhead=crow];

  // Logical reference (array of keys, no FK)
  api_searches:search_key_out:e -> results:search_keys:w [style=dashed, arrowtail=none, arrowhead=crow];
}
